Options -Indexes
DirectoryIndex index.html
AddType application/manifest+json .webmanifest

RewriteEngine On

# Redirect legacy file URLs to clean directory URLs.
RewriteCond %{THE_REQUEST} \s/+services\.html[\s?] [NC]
RewriteRule ^services\.html$ /services/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+pricing\.html[\s?] [NC]
RewriteRule ^pricing\.html$ /pricing/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+about\.html[\s?] [NC]
RewriteRule ^about\.html$ /about/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+contact\.html[\s?] [NC]
RewriteRule ^contact\.html$ /contact/ [R=301,L]

# Redirect legacy clean routes to the new marketplace architecture.
RewriteRule ^services/?$ /guest-posting-service/ [R=301,L]
RewriteRule ^industries/?$ /buy-guest-posts/ [R=301,L]
RewriteRule ^terms-of-service/?$ /terms-of-services/ [R=301,L]
RewriteRule ^da-vs-dr-in-guest-posting/?$ /high-da-guest-posts-what-matters-more-than-da/ [R=301,L]
RewriteRule ^high-da-vs-niche-relevant-guest-post-sites/?$ /high-da-guest-posts-what-matters-more-than-da/ [R=301,L]
RewriteRule ^white-hat-vs-black-hat-guest-posting/?$ /how-to-buy-guest-posts-safely/ [R=301,L]
RewriteRule ^guest-post-roi/?$ /guest-post-pricing-guide-seo-agencies/ [R=301,L]
RewriteRule ^guest-posting-benefits/?$ /guest-posting-service/ [R=301,L]
RewriteRule ^what-is-guest-posting-in-seo/?$ /guest-posting-service/ [R=301,L]

# Canonical host: HTTPS + non-www. Rules only affect the production domain.
RewriteCond %{HTTP_HOST} ^www\.guestpostplatform\.com$ [NC]
RewriteRule ^ https://guestpostplatform.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^guestpostplatform\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://guestpostplatform.com%{REQUEST_URI} [R=301,L,NE]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
